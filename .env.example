# LimeSurvey Version Configuration
# Change this to "7-apache" for LimeSurvey v7, or "6-apache" for v6
LIMESURVEY_VERSION=6-apache

# Database Configuration
DB_TYPE=mysql
DB_HOST=limesurvey-db
DB_PORT=3306
DB_NAME=limesurvey
DB_USERNAME=limesurvey
DB_PASSWORD=limesurvey123
MYSQL_ROOT_PASSWORD=rootpass

# LimeSurvey Admin Configuration
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@limesurvey.local

# LimeSurvey URL
LIMESURVEY_URL_FORMAT=http://localhost

# Test Configuration
LIMESURVEY_TEST_URL=http://localhost
LIMESURVEY_TEST_USER=admin
LIMESURVEY_TEST_PASSWORD=admin123
